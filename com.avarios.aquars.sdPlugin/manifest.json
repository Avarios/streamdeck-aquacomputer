{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.avarios.aquars",
  "Name": "Aquars Quadro",
  "Version": "1.0.2.0",
  "Author": "Avarios",
  "URL": "https://github.com/Avarios/streamdeck-aquacomputer",
  "Description": "Live Aquacomputer Quadro values on your Stream Deck: temperatures, fan/pump RPM, power and flow, with history graphs. Unofficial; currently tested only with the Aquacomputer Quadro.",
  "Category": "Aquars Quadro",
  "CategoryIcon": "assets/plugin/category-icon",
  "Icon": "assets/plugin/marketplace",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "com.avarios.aquars.temperature",
      "Name": "Temperature",
      "Tooltip": "Shows a temperature sensor of the Aquacomputer Quadro (sensor 1-4 or virtual sensor).",
      "Icon": "assets/actions/temperature/icon",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "PropertyInspectorPath": "ui/temperature.html",
      "States": [
        {
          "Image": "assets/actions/temperature/key",
          "ShowTitle": false
        }
      ],
      "Encoder": {
        "layout": "layouts/canvas.json",
        "Icon": "assets/actions/temperature/icon"
      }
    },
    {
      "UUID": "com.avarios.aquars.fan",
      "Name": "Fan / Pump",
      "Tooltip": "Shows RPM, output percent or power of a Quadro fan/pump channel. Press to cycle the view.",
      "Icon": "assets/actions/fan/icon",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "PropertyInspectorPath": "ui/fan.html",
      "States": [
        {
          "Image": "assets/actions/fan/key",
          "ShowTitle": false
        }
      ],
      "Encoder": {
        "layout": "layouts/canvas.json",
        "Icon": "assets/actions/fan/icon",
        "TriggerDescription": {
          "Rotate": "Switch RPM / % / W",
          "Push": "Switch RPM / % / W",
          "Touch": "Switch RPM / % / W"
        }
      }
    },
    {
      "UUID": "com.avarios.aquars.flow",
      "Name": "Flow",
      "Tooltip": "Shows the flow rate of the Quadro flow sensor in l/h.",
      "Icon": "assets/actions/flow/icon",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "PropertyInspectorPath": "ui/flow.html",
      "States": [
        {
          "Image": "assets/actions/flow/key",
          "ShowTitle": false
        }
      ],
      "Encoder": {
        "layout": "layouts/canvas.json",
        "Icon": "assets/actions/flow/icon"
      }
    },
    {
      "UUID": "com.avarios.aquars.rotate",
      "Name": "Rotation",
      "Tooltip": "Cycles through all Quadro values (temperatures, fans, flow, voltage). Press to skip to the next.",
      "Icon": "assets/actions/rotate/icon",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "PropertyInspectorPath": "ui/rotate.html",
      "States": [
        {
          "Image": "assets/actions/rotate/key",
          "ShowTitle": false
        }
      ],
      "Encoder": {
        "layout": "layouts/canvas.json",
        "Icon": "assets/actions/rotate/icon",
        "TriggerDescription": {
          "Rotate": "Previous / next value",
          "Push": "Next value",
          "Touch": "Next value"
        }
      }
    },
    {
      "UUID": "com.avarios.aquars.pcsensor",
      "Name": "PC Sensor",
      "Tooltip": "Shows a CPU / GPU / mainboard sensor from LibreHardwareMonitor (optional, must be running with its web server enabled).",
      "Icon": "assets/actions/pcsensor/icon",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "PropertyInspectorPath": "ui/pcsensor.html",
      "States": [
        {
          "Image": "assets/actions/pcsensor/key",
          "ShowTitle": false
        }
      ],
      "Encoder": {
        "layout": "layouts/canvas.json",
        "Icon": "assets/actions/pcsensor/icon"
      }
    }
  ]
}